{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dnshe-auto-renew",
  "main": "worker.js",
  "compatibility_date": "2026-11-14",
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  "observability": { "enabled": true },
  "kv_namespaces": [{ "binding": "RENEWAL_STATE" }],
  "triggers": { "crons": ["17 1 * * MON", "18 3 16 11 *"] }
}
